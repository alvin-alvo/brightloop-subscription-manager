# PostgreSQL (defaults are for local development only)
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
POSTGRES_PORT=5432
DATABASE_URL=postgres://brightloop:brightloop@postgres:5432/brightloop?sslmode=disable

# Public gateway ports
GATEWAY_PORT=8080
# The current frontend defaults to http://localhost:3000/api
FRONTEND_API_PORT=3000
GATEWAY_STATS_PORT=8404

# Internal service ports. These must match gateway/haproxy.cfg and
# docker-compose.yml.
AUTH_PORT=8081
USER_PORT=8082
SUBSCRIPTION_PORT=8083
NOTIFICATION_PORT=8084

# Shared JWT signing secret. Set a 32+ character value in shared environments;
# both the auth and subscription services must use the same secret.
JWT_SECRET=

# Auth service token/session settings.
JWT_ISSUER=brightloop-auth
ACCESS_TOKEN_TTL=168h
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m

# Subscription service auth/CORS. Leave JWT_SECRET empty for local development;
# set AUTH_REQUIRED=true and a 32+ character JWT_SECRET in shared environments.
AUTH_REQUIRED=false
AUTH_DEFAULT_ROLE=admin

# Demo user the user/notification services act as when no bearer identity is
# present in development (the seeded demo admin account).
AUTH_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000101

REPORTING_CURRENCY=USD
CORS_ALLOWED_ORIGINS=*
